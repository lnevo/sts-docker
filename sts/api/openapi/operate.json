{
  "paths": {
    "/commands/{command}": {
      "post": {
        "summary": "Run one catalog command",
        "description": "Role: operator. Runs a catalog command through operational_steps_dispatch_step. Unknown id: 404. The destructive ids (restore_database, backup_database, wipe_database, reset_session, restart_session, plus wipe and reset) need role admin and always run as an exclusive task (202). Flow-control and non-runnable ids are 422. Slow commands (generate_switchlists, render_switchlists, save_switchlist_cache, generate_waybills, generate_station_report, generate_wheel_report, rebuild_switchlists_index) and any request with async=true answer 202 with a task; poll GET /tasks/{id}. Any other command is a write and answers 409 while a maintenance task is queued or running. Optional timeout_seconds (1-86400) kills the task after that long: failed, \"timed out after N seconds\". Without timeout_seconds the server default applies (env STS_API_TASK_DEFAULT_TIMEOUT, seconds, default 21600; 0 = no limit) and the effective value is recorded in the task spec.",
        "x-sts-role": "operator",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CommandResult"
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Accepted as a task.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/TaskAccepted"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Another exclusive task is running (async destructive commands); also a maintenance task (queued or running exclusive task) blocks writes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          }
        },
        "parameters": [
          {
            "name": "command",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CommandId"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommandRequest"
              }
            }
          }
        }
      }
    },
    "/cars/{car}/load": {
      "post": {
        "summary": "Complete loading a car",
        "description": "Role: operator. The car must be Loading; it becomes Loaded (last_spotted reset). Any other status is 409. Returns the updated car.",
        "x-sts-role": "operator",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Car"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Car is not in Loading status; also a maintenance task (queued or running exclusive task) blocks writes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "car",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Car id, reporting marks, or RFID code"
          }
        ]
      }
    },
    "/cars/{car}/unload": {
      "post": {
        "summary": "Complete unloading a car",
        "description": "Role: operator. The car must be Unloading; it becomes Empty and its car orders are deleted. Any other status is 409. Returns the updated car.",
        "x-sts-role": "operator",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Car"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Car is not in Unloading status; also a maintenance task (queued or running exclusive task) blocks writes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "car",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Car id, reporting marks, or RFID code"
          }
        ]
      }
    },
    "/cars/{car}/reposition": {
      "post": {
        "summary": "Reposition an empty car",
        "description": "Role: operator. The car must be Empty with no car orders (else 409). Creates an E-series waybill, sets status Ordered and writes a history row, in one transaction.",
        "x-sts-role": "operator",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/RepositionResult"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Car is not Empty or already has orders; also a maintenance task (queued or running exclusive task) blocks writes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          }
        },
        "parameters": [
          {
            "name": "car",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Car id, reporting marks, or RFID code"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RepositionRequest"
              }
            }
          }
        }
      }
    },
    "/session/advance": {
      "post": {
        "summary": "Advance the session number",
        "description": "Role: operator. Increments session_nbr by one (the increment_session command).",
        "x-sts-role": "operator",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SessionAdvance"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Maintenance"
          }
        }
      }
    },
    "/car-orders/{waybill}/fill": {
      "post": {
        "summary": "Fill a car order with a chosen car",
        "description": "Role: operator. The manual assign from the Fill Orders page. The car must be Empty with no other order and match the shipment's car code. It becomes Loaded at the loading location, else Ordered; loaded=true marks it Loaded. Empty-move (E) waybills are not orders and 404.",
        "x-sts-role": "operator",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/OrderFillResult"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "description": "Order already filled, or the car is not Empty or holds an order; also a maintenance task blocks writes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "parameters": [
          {
            "name": "waybill",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Waybill number"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderFillRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CommandRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "params": {
            "type": "object",
            "description": "Command params; keys are validated against the catalog definition (GET /catalog).",
            "additionalProperties": true
          },
          "async": {
            "type": "boolean",
            "description": "Run as a task and answer 202 (always on for slow commands)."
          },
          "seed": {
            "type": "integer",
            "description": "Seeds mt_srand and STS_SIM_SEED before the command runs."
          }
        }
      },
      "CommandResult": {
        "type": "object",
        "required": [
          "command",
          "result"
        ],
        "properties": {
          "command": {
            "$ref": "#/components/schemas/CommandId"
          },
          "result": {
            "type": "object",
            "description": "The dispatch result (counts, messages) plus session_nbr_before and session_nbr_after.",
            "additionalProperties": true,
            "properties": {
              "session_nbr_before": {
                "type": "integer"
              },
              "session_nbr_after": {
                "type": "integer"
              }
            }
          }
        }
      },
      "TaskAccepted": {
        "type": "object",
        "required": [
          "task_id",
          "status"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued"
            ]
          },
          "kind": {
            "type": "string"
          }
        }
      },
      "RepositionRequest": {
        "type": "object",
        "required": [
          "location"
        ],
        "additionalProperties": false,
        "properties": {
          "location": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Destination location id or code."
          }
        }
      },
      "RepositionResult": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Car"
          },
          {
            "type": "object",
            "properties": {
              "waybill_number": {
                "type": "string",
                "description": "The new empty-car (E-series) waybill."
              },
              "destination": {
                "type": "string",
                "description": "Destination location code."
              }
            }
          }
        ]
      },
      "SessionAdvance": {
        "type": "object",
        "required": [
          "session_nbr_before",
          "session_nbr"
        ],
        "properties": {
          "session_nbr_before": {
            "type": "integer"
          },
          "session_nbr": {
            "type": "integer"
          }
        }
      },
      "OrderFillRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "car"
        ],
        "properties": {
          "car": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Car id, reporting marks or RFID code."
          },
          "loaded": {
            "type": "boolean",
            "default": false,
            "description": "Mark the car Loaded wherever it is (it already holds the load)."
          }
        }
      },
      "OrderFillResult": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CarOrder"
          },
          {
            "type": "object",
            "properties": {
              "car_status": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}

{
  "paths": {
    "/admin/tokens": {
      "get": {
        "summary": "List API tokens",
        "description": "Role: admin.",
        "x-sts-role": "admin",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Token"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Create an API token",
        "description": "Role: admin.",
        "x-sts-role": "admin",
        "responses": {
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/TokenCreated"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenCreate"
              }
            }
          }
        }
      }
    },
    "/admin/tokens/{id}": {
      "delete": {
        "summary": "Revoke an API token",
        "description": "Role: admin.",
        "x-sts-role": "admin",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Token id, e.g. tok_1a2b3c4d"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Token"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/admin/backups": {
      "post": {
        "summary": "Back up the database",
        "description": "Writes backups/<name> with backup_tables(); fast, so synchronous. 409 when the name exists (unless overwrite) or an exclusive task is active. Role: admin. The dump holds the maintenance gate: an exclusive task cannot start until it is done, and 409 is returned while one is queued or running.",
        "x-sts-role": "admin",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BackupCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Backup written",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/BackupInfo"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "409": {
            "description": "Another exclusive task is queued or running; also a maintenance task (queued or running exclusive task) blocks writes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/restore": {
      "post": {
        "summary": "Restore a backup",
        "description": "Drops every table first (full, default true; pass false to restore over the existing tables), then runs sts_restore_sql_file() on backups/<backup>, optionally refreshes rolling-stock photos from backups/<backup>_photos, then runs the plugin session-reset hooks (reason restore). Runs as an exclusive background task; poll GET /tasks/{id}. Only one exclusive task runs at a time (409 otherwise). Role: admin.",
        "x-sts-role": "admin",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RestoreRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Task accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/TaskAccepted"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "409": {
            "description": "Another exclusive task is queued or running; also a maintenance task (queued or running exclusive task) blocks writes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/warm-start": {
      "post": {
        "summary": "Simulate sessions to a warm-start state",
        "description": "Calls warm_start_run() with the same config the sts-helpers simulate_warm_start.php CLI builds; the same seed gives the same database. Omitted fields keep the warm-start defaults. Runs as an exclusive background task; poll GET /tasks/{id}. Only one exclusive task runs at a time (409 otherwise). Role: admin.",
        "x-sts-role": "admin",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WarmStartRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Task accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/TaskAccepted"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "409": {
            "description": "Another exclusive task is queued or running; also a maintenance task (queued or running exclusive task) blocks writes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/sessions/begin": {
      "post": {
        "summary": "Begin an operating session",
        "description": "Calls warm_start_begin_operating_session(). The task fails (with its result) when the session start is blocked. Runs as an exclusive background task; poll GET /tasks/{id}. Only one exclusive task runs at a time (409 otherwise). Role: admin.",
        "x-sts-role": "admin",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionBeginRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Task accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/TaskAccepted"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "409": {
            "description": "Another exclusive task is queued or running; also a maintenance task (queued or running exclusive task) blocks writes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/sessions/play": {
      "post": {
        "summary": "Play the current operating session",
        "description": "Calls warm_start_play_operating_session(). Runs as an exclusive background task; poll GET /tasks/{id}. Only one exclusive task runs at a time (409 otherwise). Role: admin.",
        "x-sts-role": "admin",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionPlayRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Task accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/TaskAccepted"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "409": {
            "description": "Another exclusive task is queued or running; also a maintenance task (queued or running exclusive task) blocks writes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/tasks/{id}/fail": {
      "post": {
        "summary": "Mark a stuck task failed",
        "description": "Role: admin. Clears a queued or running task that will not finish, which releases the maintenance lock. A running task whose process is still alive is refused with 409 unless the body says `force: true` (the process is not killed). Terminal tasks are 409. Not blocked by the maintenance lock.",
        "x-sts-role": "admin",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "force": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task marked failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Task"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Task already finished, or its process is still alive and force was not given.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Token": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "reader",
              "operator",
              "editor",
              "admin"
            ]
          },
          "created_at": {
            "type": "string"
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "TokenCreated": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Token"
          },
          {
            "type": "object",
            "properties": {
              "token": {
                "type": "string",
                "description": "Shown once."
              }
            }
          }
        ]
      },
      "TokenCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "reader",
              "operator",
              "editor",
              "admin"
            ]
          }
        },
        "required": [
          "name",
          "role"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "TaskAccepted": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued"
            ]
          },
          "kind": {
            "type": "string"
          }
        }
      },
      "BackupCreate": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "overwrite": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "BackupInfo": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "mtime": {
            "type": "string"
          }
        }
      },
      "RestoreRequest": {
        "type": "object",
        "required": [
          "backup"
        ],
        "properties": {
          "backup": {
            "type": "string",
            "description": "File name in the backups directory (GET /backups). No paths."
          },
          "photos": {
            "type": "boolean",
            "default": false,
            "description": "Clear the photo folders and copy backups/<backup>_photos/* into ImageStore/DB_Images/RollingStock."
          },
          "full": {
            "type": "boolean",
            "default": true,
            "description": "Drop every table before restoring, like DROP/CREATE DATABASE. Pass false to restore over the existing tables."
          }
        }
      },
      "WarmStartRequest": {
        "type": "object",
        "properties": {
          "sessions": {
            "type": "integer",
            "minimum": 1,
            "description": "Minimum sessions (CLI --sessions)."
          },
          "max_sessions": {
            "type": "integer",
            "minimum": 1
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "description": "Ignored for the config when continue is true."
          },
          "continue": {
            "type": "boolean",
            "description": "Advance from the current session without re-seeding."
          },
          "tracked": {
            "type": "boolean",
            "description": "Tracked-session settings supplied by an installed plugin; 422 when none provides them."
          },
          "config": {
            "type": "object",
            "additionalProperties": true,
            "description": "Extra warm-start config overrides (applied before the fields above)."
          },
          "backup": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "description": "Save the resulting state under this backup name."
          }
        }
      },
      "SessionBeginRequest": {
        "type": "object",
        "properties": {
          "load_unload": {
            "type": "boolean",
            "default": true
          },
          "increment": {
            "type": "boolean",
            "default": true
          },
          "reposition": {
            "type": "boolean",
            "default": true
          },
          "assign": {
            "type": "boolean",
            "default": true
          },
          "fill": {
            "type": "boolean",
            "default": true
          },
          "generate": {
            "type": "boolean",
            "default": false
          },
          "reposition_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "fill_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "config": {
            "type": "object",
            "additionalProperties": true
          },
          "options": {
            "type": "object",
            "additionalProperties": true,
            "description": "Extra options passed through to the warm-start scenario (layout-specific switches)."
          },
          "backup": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          }
        }
      },
      "SessionPlayRequest": {
        "type": "object",
        "properties": {
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "config": {
            "type": "object",
            "additionalProperties": true
          },
          "backup": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          }
        }
      }
    }
  }
}

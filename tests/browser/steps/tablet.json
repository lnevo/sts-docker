[
 {
  "url": "${STS_BASE}/operations.php",
  "device": "tablet",
  "actions": [
   {
    "wait": 600
   },
   {
    "expect": "document.documentElement.scrollWidth<=innerWidth+1"
   },
   {
    "tap": "a[href=\"fill_orders.php\"]"
   },
   {
    "expect": "location.pathname.endsWith('fill_orders.php')"
   },
   {
    "expect": "(function(){var bad=[].slice.call(document.querySelectorAll(\".ops-step,.ops-step-nav\")).filter(function(e){var b=e.getBoundingClientRect();return b.height>0&&b.height<40}).map(function(e){return (e.id||e.className)+':'+Math.round(e.getBoundingClientRect().height)});if(bad.length)throw new Error('small targets '+bad.join(' '));return true})()"
   },
   {
    "tap": ".ops-stepbar-inner > a.ops-step-nav:not(:first-child)"
   },
   {
    "expect": "!location.pathname.endsWith('fill_orders.php')"
   }
  ]
 },
 {
  "url": "${STS_BASE}/pick_up.php",
  "device": "phone",
  "actions": [
   {
    "waitFor": ".ops-stepbar-inner"
   },
   {
    "expect": "(function(){var i=document.querySelector('.ops-stepbar-inner');return i.scrollWidth>i.clientWidth||i.parentNode.scrollWidth>i.parentNode.clientWidth})()"
   },
   {
    "expect": "document.documentElement.scrollWidth<=innerWidth+1"
   },
   {
    "touchDrag": [
     ".ops-step[href=\"organize_cars.php\"]",
     ".ops-step[href=\"generate.php\"]"
    ]
   },
   {
    "expect": "document.querySelector('.ops-stepbar-inner > a.ops-step-nav:not(:first-child)').getBoundingClientRect().width>=40"
   },
   {
    "tap": ".ops-stepbar-inner > a.ops-step-nav:not(:first-child)"
   },
   {
    "expect": "!location.pathname.endsWith('pick_up.php')"
   }
  ]
 },

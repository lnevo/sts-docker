 {
  "url": "${STS_BASE}/build_switchlists.php",
  "device": "tablet",
  "actions": [
   {
    "wait": 600
   },
   {
    "expect": "document.documentElement.scrollWidth<=innerWidth+1"
   },
   {
    "eval": "(function(){var s=document.querySelector(\"#station_list\");var o=[].slice.call(s.options).filter(function(o){return o.value!==''});var t=o.filter(function(x){return /./.test(x.text)})[0]||o[0];s.value=t.value;s.dispatchEvent(new Event('change',{bubbles:true}));s.dispatchEvent(new Event('input',{bubbles:true}))})()"
   },
   {
    "wait": 1200
   },
   {
    "expect": "(function(){var bad=[].slice.call(document.querySelectorAll(\"#station_list,#auto_assign_job,.btn\")).filter(function(e){var b=e.getBoundingClientRect();return b.height>0&&b.height<40}).map(function(e){return (e.id||e.className)+':'+Math.round(e.getBoundingClientRect().height)});if(bad.length)throw new Error('small targets '+bad.join(' '));return true})()"
   }
  ]
 },
 {
  "url": "${STS_BASE}/pick_up.php",
  "device": "tablet",
  "actions": [
   {
    "wait": 600
   },
   {
    "expect": "document.documentElement.scrollWidth<=innerWidth+1"
   },
   {
    "eval": "(function(){var s=document.querySelector(\"#job_list\");var o=[].slice.call(s.options).filter(function(o){return o.value!==''});var t=o.filter(function(x){return x.value==='${STS_JOB1_ID}'})[0]||o[0];s.value=t.value;s.dispatchEvent(new Event('change',{bubbles:true}));s.dispatchEvent(new Event('input',{bubbles:true}))})()"
   },
   {
    "waitFor": "#job_table_div table input[type=checkbox]"
   },
   {
    "tap": "#job_table_div table tbody input[type=checkbox]"
   },
   {
    "wait": 300
   }
  ]
 },
 {
  "url": "${STS_BASE}/organize_cars.php",
  "device": "tablet",
  "cookie": "sts_api_sandbox=${STS_TEST_COOKIE}",
  "actions": [
   {
    "wait": 600
   },
   {
    "expect": "document.documentElement.scrollWidth<=innerWidth+1"
   },
   {
    "eval": "(function(){var s=document.querySelector(\"#job_list\");var o=[].slice.call(s.options).filter(function(o){return o.value!==''});var t=o.filter(function(x){return x.value==='${STS_JOB1_ID}'})[0]||o[0];s.value=t.value;s.dispatchEvent(new Event('change',{bubbles:true}));s.dispatchEvent(new Event('input',{bubbles:true}))})()"
   },
   {
    "tap": "#org_job"
   },
   {
    "waitFor": "#car_table_body tr"
   },
   {
    "wait": 400
   },
   {
    "eval": "window.__marks=function(){return [].slice.call(document.querySelectorAll('#car_table_body tr')).map(function(r){return r.cells[2].innerText.trim()}).join(',')};window.__before=window.__marks()"
   },
   {
    "touchDrag": [
     "#car_table_body tr:first-child .drag-handle",
     "#car_table_body tr:last-child .drag-handle"
    ]
   },
   {
    "expect": "window.__marks()!==window.__before"
   },
   {
    "eval": "window.__after=window.__marks()"
   },
   {
    "tap": "#update_pos"
   },
   {
    "wait": 1200
   },
   {
    "expect": "fetch('${STS_BASE}/api/v1/cars?job='+encodeURIComponent(document.getElementById('job_list').selectedOptions[0].text.replace(/ \\(.*$/,'')),{headers:{Authorization:'Bearer ${STS_TEST_TOKEN}'}}).then(function(r){return r.json()}).then(function(j){var order=j.data.slice().sort(function(a,b){return a.position-b.position}).map(function(c){return c.reporting_marks}).join(',');return order===window.__after})"
   }
  ]
 },

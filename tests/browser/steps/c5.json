[
 {
  "url": "${STS_BASE}/display_station_report.php",
  "actions": [
   {
    "select": [
     "#station_name",
     "0"
    ]
   },
   {
    "expect": "!document.getElementById('display_btn').disabled"
   },
   {
    "expect": "document.querySelector('#station_name option[value=\"0\"]').text==='All'"
   },
   {
    "click": "#display_btn"
   },
   {
    "waitFor": "#report-content table"
   },
   {
    "expect": "document.querySelector('#report-content').innerText.indexOf('BO')>=0"
   },
   {
    "click": "#reading-btn"
   },
   {
    "expect": "document.body.classList.contains('reading-mode')"
   },
   {
    "click": "#reading-btn-report"
   },
   {
    "expect": "!document.body.classList.contains('reading-mode')"
   },
   {
    "eval": "window.XMLHttpRequest=function(){this.open=function(){};this.send=function(){this.status=200}};window.open=function(){window.__w={document:{write:function(t){window.__t=t},title:''}};return window.__w}"
   },
   {
    "click": "#report-content [data-sts-click=showImage]"
   },
   {
    "expect": "typeof window.__t==='string' && window.__t.indexOf('Image')>=0"
   },
   {
    "click": "[data-sts-click=modifySearch]"
   },
   {
    "expect": "!document.getElementById('report-container').classList.contains('show')"
   },
   {
    "eval": "window.__p=0;window.print=function(){window.__p++}"
   },
   {
    "click": ".print-controls [data-sts-print]"
   },
   {
    "expect": "window.__p===1"
   }
  ]
 },

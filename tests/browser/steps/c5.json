  "url": "${STS_BASE}/display_switchlist.php",
  "actions": [
   {
    "select": [
     "#job_name",
     "1"
    ]
   },
   {
    "expect": "!document.getElementById('display_btn').disabled"
   },
   {
    "click": "#half"
   },
   {
    "click": "#display_btn"
   },
   {
    "waitFor": "#report-content .sw-report"
   },
   {
    "expect": "document.getElementById('half_sheet_job_instructions').style.display!=='none'"
   },
   {
    "click": "#half_sheet_checkbox"
   },
   {
    "expect": "document.getElementById('half_sheet_job_instructions').style.display==='none'"
   },
   {
    "click": "#half_sheet_checkbox"
   },
   {
    "expect": "document.getElementById('half_sheet_job_instructions').style.display!=='none'"
   },
   {
    "eval": "window.__n=document.getElementById('consist').rows.length"
   },
   {
    "type": [
     "#comment",
     "BLANK ROW"
    ]
   },
   {
    "click": "[data-sts-click=findCar][data-start='1']"
   },
   {
    "expect": "document.getElementById('consist').rows.length===window.__n+1"
   },
   {
    "expect": "document.querySelector('#consist [data-sts-click=moveRow]')!==null"
   },
   {
    "click": "#consist [data-sts-click=moveRow][data-move='1']"
   },
   {
    "expect": "document.querySelector('#consist [data-sts-click=moveRow]')!==null"
   },
   {
    "eval": "window.__p=0;window.print=function(){window.__p++}"
   },
   {
    "click": "[data-sts-print]"
   },
   {
    "expect": "window.__p===1"

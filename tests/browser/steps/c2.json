 {
  "url": "${STS_BASE}/organize_cars.php",
  "actions": [
   {
    "expect": "document.getElementById('org_job').disabled===true && document.getElementById('update_pos').disabled===true"
   },
   {
    "select": [
     "#job_list",
     "${STS_JOB1_ID}"
    ]
   },
   {
    "expect": "document.getElementById('org_job').disabled===false"
   },
   {
    "click": "#org_job"
   },
   {
    "waitFor": "#car_table_body tr"
   },
   {
    "expect": "document.querySelectorAll('#car_table_body tr').length>1 && document.getElementById('update_pos').disabled===false"
   },
   {
    "eval": "(()=>{\n var rows=[...document.querySelectorAll('#car_table_body tr')];\n var a=rows[0].querySelector('.drag-handle'), r0=rows[0].getBoundingClientRect(), r1=rows[1].getBoundingClientRect();\n sessionStorage.dragged=rows[0].querySelector('td[data-sts-click=showImage] input[type=hidden]').value;\n var y0=(r0.top+r0.bottom)/2, y1=(r1.top+r1.bottom)/2+4;\n a.dispatchEvent(new MouseEvent('mousedown',{bubbles:true,cancelable:true,clientX:20,clientY:y0}));\n document.dispatchEvent(new MouseEvent('mousemove',{bubbles:true,cancelable:true,clientX:20,clientY:y1}));\n document.dispatchEvent(new MouseEvent('mouseup',{bubbles:true,cancelable:true,clientX:20,clientY:y1}));\n})()"
   },
   {
    "expect": "document.querySelector('#car_table_body tr:nth-child(2) td[data-sts-click=showImage] input[type=hidden]').value===sessionStorage.dragged"
   },
   {
    "expect": "document.querySelector('#car_table_body tr:nth-child(2)').cells[1].textContent.trim()==='2'"
   },
   {
    "click": "#update_pos"
   },
   {
    "wait": 1500
   },
   {
    "expect": "document.getElementById('update_feedback').textContent.includes('saved')"
   },
   {
    "expect": "(async()=>{const j=await fetch('${STS_BASE}/api/v1/cars?limit=1000',{headers:{Authorization:'Bearer ${STS_TEST_TOKEN}'}}).then(r=>r.json());return (d=>d.find(c=>String(c.id)===sessionStorage.dragged).position==2)(j.data)})()"
   },
   {
    "select": [
     "#location_list",
     "${STS_LOC_ID}"
    ]
   },
   {
    "expect": "document.getElementById('org_loc').disabled===false"
   },
   {
    "click": "#org_loc"
   },
   {
    "wait": 1200
   },
   {
    "expect": "!!document.getElementById('car_section').innerText.length"
   }
  ]
